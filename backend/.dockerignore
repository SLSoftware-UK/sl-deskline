# The Dockerfile's `COPY . .` copies this directory as-is, so anything
# that shouldn't end up baked into the image -- secrets, a developer's
# local database, dependencies that get reinstalled at build time anyway,
# and anything else local-only -- must be excluded here explicitly. There
# is no implicit filtering: a file merely being in .gitignore does not
# stop `docker build` from picking it up from the build context.

# Secrets -- a developer's own backend/.env (DEBUG=True, a throwaway
# SECRET_KEY, live SSO/email credentials) must never be baked into an
# image that gets pushed or shared. settings.py's read_env() also fails
# open on a missing SECRET_KEY when DEBUG=True, so shipping a dev .env
# would additionally make the image boot "successfully" in an insecure
# default state instead of refusing to start.
.env
.env.*
!.env.example

# Local SQLite database and its WAL sidecars -- may hold real password
# hashes and ticket content from local development; production data
# belongs on the mounted volume (DATA_DIR), never in the image layer.
*.sqlite3
*.sqlite3-*
db.sqlite3
db.sqlite3-*

# Virtualenv -- reinstalled from requirements.txt at build time; copying
# a host venv in would also bake in host-specific paths and platform-
# specific compiled wheels.
.venv/
venv/

# User-uploaded media and collected static files -- media belongs on the
# mounted volume, not the image; static files are regenerated by the
# Dockerfile's own `collectstatic` step during the build.
media/
staticfiles/

# Python bytecode / caches.
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Version control and editor/OS cruft -- irrelevant at runtime and can
# carry history/metadata that has no business in an image.
.git/
.gitignore
.gitattributes
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs.
*.log
