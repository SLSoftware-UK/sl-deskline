# Every environment variable support_core/settings.py reads, and nothing
# it doesn't. Copy to backend/.env for local dev (that file is
# gitignored); in production set these however your host manages
# environment variables.
#
# The values below are the LOCAL DEV ones, so a verbatim copy works on
# localhost:8000 straight away. Where the production value differs it is
# recorded in the comment above the variable — read those before
# deploying. The examples assume a help centre at help.example.com and,
# optionally, the ticket desk on its own host at support.example.com.
#
# One django-environ trap worth knowing before you "blank" a value here:
# a key that is present but empty is NOT the same as an absent key. The
# settings module's default only applies when the key is absent
# (environ.Env.get_value), so `SITE_URL=` yields the empty string, not
# 'http://localhost:8000'. The single exception is a setting whose
# default is None — environ turns an empty value into None in that case,
# which is why SESSION_COOKIE_DOMAIN below is deliberately left blank.
# Anything you don't need, comment out rather than blank.

# This service's own Django signing key (sessions, CSRF, password reset).
# Nothing is signed across services, so it is shared with nothing else.
# Any long random string will do. Required in production: the settings
# module refuses to boot without it unless DEBUG is on.
SECRET_KEY=change-me

# Local dev only. Unset/False in production — it fails closed, and HSTS,
# SSL-redirect and secure cookies all key off it.
DEBUG=True

# The one directory this service keeps everything stateful under: the
# SQLite database file and uploaded media both live here by default (see
# DATABASE_URL and MEDIA_ROOT below). In production, point this at your
# volume's mount path.
# Production: /data
# Left unset locally, which defaults to the repo's backend/ directory —
# a plain checkout with no .env changes still works, writing db.sqlite3
# and media/ right there.
# DATA_DIR=/data

# Postgres connection string, for anyone who wants Postgres instead of
# the SQLite-on-DATA_DIR default (see DATA_DIR above). Optional — this
# service runs perfectly well on SQLite alone, which is what "one
# container, one volume, nothing else to provision" means in practice.
# Left COMMENTED OUT rather than blank, because the SQLite fallback needs
# the variable to be genuinely absent: a blank `DATABASE_URL=` is a
# present-but-empty value, so dj_database_url.config() never reaches its
# `default=` and returns {} — which Django then fills in with
# ENGINE='django.db.backends.dummy', so the first query fails with
# "settings.DATABASES is improperly configured. Please supply the ENGINE
# value" instead of using DATA_DIR/db.sqlite3. Absent, and local dev gets
# SQLite with no further setup.
# DATABASE_URL=postgres://user:password@host/dbname

# Every hostname this service answers on (comma-separated), and the
# matching https:// origins for CSRF. The defaults cover localhost only.
# Production: help.example.com,support.example.com (plus any hostname
# your platform's healthcheck uses)
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: https://help.example.com,https://support.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Parent domain the session cookie is scoped to, so a user recognised on
# help.example.com is still recognised on support.example.com. Only
# needed when the help centre and ticket desk are on different hosts;
# leave blank for a single host.
# Production (two hosts): .example.com
# Left BLANK here on purpose, and it must stay blank locally: a browser
# will not set a '.example.com' cookie on a page served from localhost,
# so copying the production value straight across makes local login fail
# silently — you sign in, the response sets a cookie the browser drops,
# and the next request is anonymous again with no error anywhere.
# Blank is safe (rather than merely empty) because this setting's
# default is None — see the django-environ note in the header.
# The cookie's NAME is fixed in code (deskline_sessionid) and must not
# be plain 'sessionid' — see the settings comment.
SESSION_COOKIE_DOMAIN=

# Canonical site origin, used to build absolute URLs for OG/canonical
# tags, sitemap.xml and schema.org data — these must be absolute, not
# host-relative, so social/AI crawlers resolve them correctly.
# Production: https://help.example.com
SITE_URL=http://localhost:8000

# How people sign in. 'local' (the default) is plain Django auth: a
# username/email + password form at /login/ for every account, with
# accounts made in Django Admin or by `createsuperuser` — no external
# service needed. 'code_exchange' hands customer sign-in to an external
# identity provider (see accounts/sso.py for the exchange contract);
# support agents then sign in at /staff/login/. Any other value refuses
# to boot.
SSO_BACKEND=local

# code_exchange only — both required in that mode, ignored otherwise.
# SSO_EXCHANGE_URL is the full URL of the provider's code-redemption
# endpoint (this service POSTs {"code": ...} to it, server-to-server).
# SSO_PROVIDER_LOGIN_URL is where /login/ sends a visitor to sign in at
# the provider (?next=<path> is appended).
# SSO_EXCHANGE_URL=https://id.example.com/api/sso/exchange/
# SSO_PROVIDER_LOGIN_URL=https://id.example.com/login

# Hostnames treated as "the ticket desk" (comma-separated): a bare / on
# one of them redirects to /tickets/. Empty by default — a single-host
# deployment serves the desk at /tickets/ on the help host and needs no
# redirect. Don't add localhost here: it would send the local KB
# homepage to /tickets/.
# Production (two hosts): support.example.com
# TICKET_HOSTS=support.example.com

# Absolute origin for ticket links in notification emails and for
# cross-host links from the KB (the header's "Tickets" link and an
# article's "Raise a ticket" CTA, when the page is served on the help
# host). Defaults to SITE_URL, which is right for a single host and for
# local dev, where one runserver serves both halves.
# Production (two hosts): https://support.example.com
# TICKET_SITE_URL=https://support.example.com

# Outbound email (ticket notifications). The default backend is the
# console under DEBUG; otherwise it is Django's plain SMTP backend,
# configured by the EMAIL_HOST* variables below — unless SMTP2GO_API_KEY
# is set, in which case it is tickets.email_backend.SMTP2GOBackend, which
# sends over HTTPS for hosts that block outbound SMTP ports.
# Set EMAIL_BACKEND only to override that choice (e.g. to silence mail
# in a non-DEBUG environment). Spelled out here rather than left blank:
# an empty value is a present value, so `EMAIL_BACKEND=` gives Django
# the empty string and sending a notification dies on
# `import_string('')`.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP (the non-DEBUG default). Defaults: localhost, 25, no auth, no TLS.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@example.com
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=True
# Seconds before an SMTP send gives up (default 10). Keep it well under
# gunicorn's 120s worker timeout — notifications are sent inside the
# request that saves the ticket.
# EMAIL_TIMEOUT=10

# SMTP2GO (alternative to SMTP). Setting this switches the non-DEBUG
# default backend to SMTP2GO's HTTPS API.
# SMTP2GO_API_KEY=api-XXXXXXXXXXXXXXXXXXXXXXXX

# Fallback sender address. The notification from-address in Site
# settings (Django Admin -> Branding) takes precedence when it is set.
DEFAULT_FROM_EMAIL=noreply@localhost

# Cache. Only consumer today is the sign-in brute-force throttle.
# Production: set this to a Redis URL (an existing Redis you already run
# is fine — it does not need its own instance).
# Absent locally, which is fine: settings.py falls back to LocMemCache.
# That fallback is PER PROCESS, so with gunicorn's 2 workers the throttle
# counter is effectively halved and is wiped on every deploy — it works,
# but it is weaker. Set REDIS_URL in production.
# REDIS_URL=redis://default:password@host:6379

# Password sign-in lockout (/login/, or /staff/login/ with SSO): how
# many failures from one (IP, identifier) pair before it locks, and for
# how long. Defaults are 5 and 900 (15 minutes); both are settings.py
# defaults too, so leaving these unset changes nothing.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900

# Max article/photo upload size in bytes (25MB). Enforced by
# kb/validators.py (the ArticlePhoto.image validator) and by
# kb/views.py::markdown_image_upload for drag-and-drop inline images.
# 25MB is also the settings.py default, so leaving this unset changes
# nothing; lower it to tighten the limit.
MAX_PHOTO_UPLOAD_SIZE=26214400

# Housekeeping: after every article create/edit/delete, delete files
# under markdownx/ in storage that no article body references any more.
#
# LEAVE THIS FALSE unless storage holds only images this database knows
# about. "Orphaned" is worked out from the articles in THIS database, so
# against a media directory with content from elsewhere (a previous
# install, a restored backup without its database), the first article
# you save deletes all of it. Safe to turn on once storage and database
# belong together; it is only a tidiness feature, nothing depends on it.
# See support_core/settings.py.
KB_PURGE_ORPHANED_IMAGES=False

# Uploaded images. Defaults to DATA_DIR/media (see DATA_DIR above), so it
# need not be set at all in the common case — it exists as its own
# variable only for a deployment that wants uploads on different storage
# from the database. A single mounted volume attaches to one container,
# so the service must stay at a single replica.
#
# There is deliberately no object storage here: a single volume does the
# same job as a bucket, with one fewer resource to provision and no
# presigned-URL machinery. If you ever do introduce a remote image
# origin, security_middleware.py's CSP img-src has to learn about it or
# every article image is silently blocked.
# MEDIA_ROOT=/data/media

# Not listed above, on purpose: PORT. Many platforms inject it, and
# backend/Dockerfile's CMD reads it (gunicorn --bind 0.0.0.0:${PORT:-8000});
# settings.py never looks at it, and `runserver 8000` sets the local
# port on the command line.
